+        private async void BtnServerLoadOnClick(object? sender, RoutedEventArgs e)
+        {
+            var ServerUrl = Model?.ServerURL?.Trim();
+
+            if (string.IsNullOrWhiteSpace(ServerUrl) || !ServerUrl.IsValidURL())
+            {
+                await MessageBox.ShowAsync("Type the server address in Server > Address first.\nExample: https://my-server:10000/files", "DirectPackageInstaller", MessageBoxButtons.OK, MessageBoxIcon.Warning);
+                return;
+            }
+
+            var OriStatus = Status.Text;
+            btnServerLoad.IsEnabled = false;
+
+            try
+            {
+                await SetStatus("Loading the server package list...");
+
+                var Entries = await ServerListing.FetchPackages(ServerUrl);
+
+                if (Entries.Count == 0)
+                {
+                    await SetStatus(OriStatus);
+                    await MessageBox.ShowAsync("No .pkg file was found at this address.", "DirectPackageInstaller", MessageBoxButtons.OK, MessageBoxIcon.Information);
+                    return;
+                }
+
+                BatchList.Clear();
+
+                if (Entries.Count == 1)
+                {
+                    //Single package: just fill the URL box, press Load/Open as usual
+                    tbURL.Text = Entries[0].Url;
+                    await SetStatus("1 package found on the server.");
+                    return;
+                }
+
+                BatchList.AddRange(Entries.Select(x => (x.Url, x.Display)));
+                ListEntries(Entries.Select(x => x.Url).ToArray());
+                PackagesMenu.IsVisible = true;
+
+                await SetStatus($"{Entries.Count} packages found. Choose one in the Packages menu.");
+            }
+            catch (Exception ex)
+            {
+                await SetStatus(OriStatus);
+                await MessageBox.ShowAsync("Failed to load the server list:\n" + ex.Message, "DirectPackageInstaller", MessageBoxButtons.OK, MessageBoxIcon.Error);
+            }
+            finally
+            {
+                btnServerLoad.IsEnabled = true;
+            }
+        }
